{
  "name": "bondfire-api",
  "version": "1.0.0",
  "description": "Node.js Express API for Bondfire mobile app",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "node migrations/runner.js",
