  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-openapi-validator": "^5.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "ajv": "^8.20.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.3.0"
