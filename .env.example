# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port (default 3000)
PORT=3000
# MongoDB connection string (required except when NODE_ENV=test)
MONGODB_URI=mongodb://localhost:27017/bondfire
# Log level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Public base URL used in the Swagger UI server list (optional)
API_BASE_URL=
# Comma-separated list of browser origins allowed by CORS.
# Unset: a local-development list outside production, none in production.
# Requests without an Origin header (mobile apps, curl) are always allowed.
CORS_ORIGINS=

# --- Access and refresh tokens ---
# Required for every NODE_ENV except development (also when unset) and test, so
# staging and production must set them. In development and test, empty means
# ephemeral keys are generated at startup (a warning is logged; tokens do not survive a restart).
# ES256 (P-256) key pair as PEM. In an env file, write line breaks as \n.
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('JWT_PRIVATE_KEY='+JSON.stringify(k.privateKey.export({type:'pkcs8',format:'pem'})).slice(1,-1));console.log('JWT_PUBLIC_KEY='+JSON.stringify(k.publicKey.export({type:'spki',format:'pem'})).slice(1,-1))"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Short name for the signing key, written into every token header (for example 2026-10)
JWT_KEY_ID=
# 32-byte key, base64. Protects the refresh-token grace cache.
#   openssl rand -base64 32
TOKEN_ENC_KEY=
# Access token lifetime in seconds (default 900, at most 3600)
ACCESS_TOKEN_TTL_SECONDS=
# Refresh token lifetime in days (default 60, at most 180)
REFRESH_TOKEN_TTL_DAYS=
# Seconds in which a repeated refresh from the same install gets the same new pair (default 30, at most 120)
REFRESH_GRACE_SECONDS=
# Token issuer and audience (defaults bondfire-api and bondfire-app)
JWT_ISSUER=
JWT_AUDIENCE=

# --- Reverse proxy ---
# How many reverse proxies (load balancer, CDN) sit in front of the API: 0 (none) to 10.
# Required for every NODE_ENV except development (also when unset) and test, where it defaults to 0.
# Needed so IP addresses used for rate limits are the caller's, not the proxy's.
# Never set it higher than the real number: clients could then choose their own IP.
TRUST_PROXY=

# --- One-time codes (sent by email and SMS) ---
# 32-byte key, base64. Codes are stored only as an HMAC made with it.
# Required for every NODE_ENV except development (also when unset) and test; there, empty means an
# ephemeral key is generated at startup (codes that were sent stop working after a restart).
#   openssl rand -base64 32
CODE_HMAC_KEY=
# How email is sent: smtp or console (logs only, sends nothing). Default: console in development
# and test, smtp everywhere else. console is only allowed when NODE_ENV is development or test.
EMAIL_PROVIDER=
# SMTP server, used when EMAIL_PROVIDER is smtp. SMTP_HOST and SMTP_FROM are required then.
SMTP_HOST=
# Default 587 (STARTTLS). Port 465 uses TLS from the start. Outside development and test the
# connection must be encrypted: STARTTLS is required, and a server that cannot offer it is not used.
SMTP_PORT=
# Set both or neither
SMTP_USER=
SMTP_PASS=
# Sender, for example: Bondfire <no-reply@example.com>
SMTP_FROM=
# SMS provider. Only console (logs only, sends nothing) exists until the real provider is chosen.
SMS_PROVIDER=
# Phone numbers that may be verified: comma-separated two-letter country codes (US,IN). Empty: every country.
PHONE_REGIONS=
# true: refuse VoIP numbers (fewer fake accounts, but some real users have only a VoIP number)
PHONE_REFUSE_VOIP=
# --- What GET /config tells the app ---
# Oldest app version still allowed per platform (older builds get 426 UPGRADE_REQUIRED). Default 1.0.0.
APP_MIN_VERSION_IOS=
APP_MIN_VERSION_ANDROID=
APP_MIN_VERSION_WEB=
# Newest version, for an optional "update available" prompt. Optional.
APP_LATEST_VERSION_IOS=
APP_LATEST_VERSION_ANDROID=
APP_LATEST_VERSION_WEB=
# Remote switches (default true): continue as a guest; phone number required during onboarding
GUEST_MODE=
PHONE_VERIFICATION_REQUIRED=
# Countries where content is available (GET /countries contentAvailable), like US. Empty: not reported.
CONTENT_REGIONS=
# Phone picker's preselected country when the request does not say (default US)
DEFAULT_COUNTRY_CODE=
# Development only (NODE_ENV=development): also print each code in the log, so you can type it into the app.
LOG_CODES_IN_DEV=
# Staging test mode. When CODE_TEST_MODE is true, the recipients listed below get CODE_TEST_VALUE as
# their code and nothing is sent to them. Everyone else is unaffected. Those recipients are still
# limited like anyone else (5 codes a day, 5 guesses per code).
# Only allowed when NODE_ENV is exactly staging, development (or unset) or test. With any other value
# (production, prod, Production ...) the API refuses to start. Recipients and value are required when it is true.
CODE_TEST_MODE=
# Comma-separated emails and phone numbers
CODE_TEST_RECIPIENTS=
# Exactly 6 digits
CODE_TEST_VALUE=

# --- Password hashing (argon2id) ---
# Cost of hashing a password. The defaults are OWASP's minimum for argon2id; leave them unset unless
# you have measured a stronger setting on the real server. Existing hashes keep working when these
# change (each hash stores its own settings) and are upgraded the next time the user signs in.
# Memory in KiB (default 19456 = 19 MiB, at most 1048576)
ARGON2_MEMORY_KIB=
# Number of passes (default 2, at most 10)
ARGON2_TIME_COST=
# Parallel lanes (default 1, at most 16; memory must be at least 8 times this)
ARGON2_PARALLELISM=
