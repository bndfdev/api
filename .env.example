# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port (default 3000)
PORT=3000
# MongoDB connection string (required except when NODE_ENV=test)
MONGODB_URI=mongodb://localhost:27017/bondfire
# Log level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Public base URL used in the Swagger UI server list (optional)
API_BASE_URL=
# Comma-separated list of browser origins allowed by CORS.
# Unset: a local-development list outside production, none in production.
# Requests without an Origin header (mobile apps, curl) are always allowed.
CORS_ORIGINS=

# --- Access and refresh tokens ---
# Required for every NODE_ENV except development (also when unset) and test, so
# staging and production must set them. In development and test, empty means
# ephemeral keys are generated at startup (a warning is logged; tokens do not survive a restart).
# ES256 (P-256) key pair as PEM. In an env file, write line breaks as \n.
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('JWT_PRIVATE_KEY='+JSON.stringify(k.privateKey.export({type:'pkcs8',format:'pem'})).slice(1,-1));console.log('JWT_PUBLIC_KEY='+JSON.stringify(k.publicKey.export({type:'spki',format:'pem'})).slice(1,-1))"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Short name for the signing key, written into every token header (for example 2026-10)
JWT_KEY_ID=
# 32-byte key, base64. Protects the refresh-token grace cache.
#   openssl rand -base64 32
TOKEN_ENC_KEY=
# Access token lifetime in seconds (default 900, at most 3600)
ACCESS_TOKEN_TTL_SECONDS=
# Refresh token lifetime in days (default 60, at most 180)
REFRESH_TOKEN_TTL_DAYS=
# Seconds in which a repeated refresh from the same install gets the same new pair (default 30, at most 120)
REFRESH_GRACE_SECONDS=
# Token issuer and audience (defaults bondfire-api and bondfire-app)
JWT_ISSUER=
JWT_AUDIENCE=

# --- Reverse proxy ---
# How many reverse proxies (load balancer, CDN) sit in front of the API: 0 (none) to 10.
# Required for every NODE_ENV except development (also when unset) and test, where it defaults to 0.
# Needed so IP addresses used for rate limits are the caller's, not the proxy's.
# Never set it higher than the real number: clients could then choose their own IP.
TRUST_PROXY=
